# 复制为 .env 并填入真实值（.env 不会进 Git）
# cp .env.example .env

# ---- 后端 ----
# Puzzle 编号加盐 secret（必须与生成 neighbors.sqlite 时一致，否则每日题目对不上）
PUZZLE_SECRET=

# Neon Postgres 连接串（用 pooler 连接以适配 serverless / 多副本，但本部署单副本也无害）
# 例：postgres://user:password@host-pooler.neon.tech/dbname?sslmode=require
DATABASE_URL=

# ---- QQ Bot ----
# 来自 QQ 开放平台 -> 我的应用 -> 开发设置
QQBOT_APPID=
QQBOT_APPSECRET=
