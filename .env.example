# Vercel + Neon 部署所需的环境变量示例
# 复制到 .env（本地）或在 Vercel 项目 Settings → Environment Variables 中配置

# ----- 必填 -----

# 谜底编号签名密钥（必须设置为足够长的随机字符串；
# 一旦设定不要轻易变更，否则所有已分享的 puzzle_code 都会失效）
PUZZLE_SECRET=please-change-me-to-a-long-random-string

# Neon Postgres 连接串
# Neon 控制台 → 你的项目 → Connection Details → Pooled connection
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/dbname?sslmode=require

# ----- 可选 -----

# 引擎模式：local | light | auto（默认 auto；Vercel 上 api/index.py 会强制为 light）
# SEMANTLE_ENGINE=auto

# 排行榜 token 签名密钥（不填则与 PUZZLE_SECRET 同源）
# LEADERBOARD_SECRET=
