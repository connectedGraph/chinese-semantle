# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv-*/
venv/
.env

# Word vectors (large files — only generated/used locally for the precompute step)
backend/data/*.kv
backend/data/*.kv.vectors.npy
backend/data/*.tar.gz
backend/data/*.bin

# Keep whitelist & target_words in repo (small text inputs to precompute)
!backend/data/whitelist.txt
!backend/data/target_words.txt
!backend/data/blacklist_memo.txt
!backend/data/README.md

# Keep precomputed data in repo (so Vercel can run without 1GB embedding)
!backend/data/precomputed/
# 但忽略 SQLite WAL 模式的临时文件
backend/data/precomputed/*.sqlite-shm
backend/data/precomputed/*.sqlite-wal

# IDE
.vscode/
.codebuddy/
.idea/
.DS_Store

# Vercel
.vercel/

# Logs
*.log

# QQ Bot 本地配置（包含 AppID/AppSecret）
qqbot/config.yaml
qqbot/nicknames.json
qqbot/data/*
!qqbot/data/.gitkeep
qqbot/.bot.lock
qqbot/*.log

# botpy 默认会在 cwd 生成 botpy.log（虽然代码已禁用文件 handler，仍兜底）
botpy.log
botpy.log.*
